# =============================================================================
# API KEYS — LLM providers
# =============================================================================

# OpenAI — used for models with provider="openai" in model_configs
OPENAI_API_KEY=your_openai_api_key_here
# Optional: override the OpenAI base URL (e.g. for Azure or a compatible proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google / Gemini — used for models with provider="vertex_ai" in model_configs
GOOGLE_API_KEY=your_google_api_key_here

# vLLM / custom endpoint — used for models with provider="custom" in model_configs
# Set vllm_base_url to your served model's /v1 endpoint (local or RunPod proxy)
VLLM_API_KEY=your_vllm_or_runpod_api_key_here
vllm_base_url=https://<pod-id>-<port>.proxy.runpod.net/v1

# =============================================================================
# CHAT CONTINUATION MODEL
# Used by generate_chat_reply() in pipeline.py for the interactive chat feature.
# Can be any model name recognised by the configured provider.
# =============================================================================
CHAT_MODEL=gpt-4o-mini

# =============================================================================
# MODEL SELECTION
#
# MODEL_CONFIGS — registry of all available models.
#   Each key is a short display name; value sets the provider and the exact
#   model string passed to that provider's API.
#   Providers:
#     "openai"     → uses OPENAI_API_KEY / OPENAI_BASE_URL
#     "vertex_ai"  → uses GOOGLE_API_KEY / google_base_url
#     "custom"     → uses VLLM_API_KEY   / vllm_base_url   (local vLLM, RunPod, etc.)
#
# RETRIEVER_MODELS / GENERATOR_MODELS — which keys from MODEL_CONFIGS are
#   offered for retrieval and generation respectively.
#   The pipeline uses the first entry as the default when none is specified.
#
# Examples — pick ONE of the blocks below and uncomment it:

# --- OpenAI only ---
# MODEL_CONFIGS={"gpt-4o-mini": {"provider": "openai", "api_model": "gpt-4o-mini"}}
# RETRIEVER_MODELS=["gpt-4o-mini"]
# GENERATOR_MODELS=["gpt-4o-mini"]

# --- Gemini only ---
# MODEL_CONFIGS={"gemini-flash": {"provider": "vertex_ai", "api_model": "gemini-2.0-flash"}}
# RETRIEVER_MODELS=["gemini-flash"]
# GENERATOR_MODELS=["gemini-flash"]

# --- Local vLLM / RunPod only ---
# MODEL_CONFIGS={"Qwen3-4B": {"provider": "custom", "api_model": "Qwen/Qwen3-4B"}}
# RETRIEVER_MODELS=["Qwen3-4B"]
# GENERATOR_MODELS=["Qwen3-4B"]

# --- Mix: Gemini retriever + vLLM generator ---
# MODEL_CONFIGS={"gemini-flash": {"provider": "vertex_ai", "api_model": "gemini-2.0-flash"}, "Qwen3-4B": {"provider": "custom", "api_model": "Qwen/Qwen3-4B"}}
# RETRIEVER_MODELS=["gemini-flash"]
# GENERATOR_MODELS=["Qwen3-4B"]

# =============================================================================
# PIPELINE MODE
# Set to true to run with mock data (no real API/DB calls needed).
# Set to false (default) to run the full pipeline.
# =============================================================================
PIPELINE_USE_MOCK=false

# =============================================================================
# EMBEDDING SERVICE (Qwen3-Embedding-4B via vLLM)
# Either set embedding_url (full base URL, takes priority) or host + port.
# =============================================================================
search__api_weaviate__embedding_url=https://<pod-id>-8018.proxy.runpod.net/v1
# search__api_weaviate__embedding_host=localhost
# search__api_weaviate__embedding_port=8018
search__api_weaviate__embedding_api_key=your_embedding_service_api_key_here

# =============================================================================
# WEAVIATE (vector store)
# =============================================================================
search__api_weaviate__url=http://your_weaviate_host_here
search__api_weaviate__api_key=your_weaviate_api_key_here
# VPS_IP is a legacy alias for the same host used by other parts of the stack
VPS_IP=your_vps_ip_here

# =============================================================================
# NEO4J (knowledge graph)
# =============================================================================
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# =============================================================================
# HUGGING FACE (model downloads)
# =============================================================================
HF_TOKEN=your_hf_token_here

# =============================================================================
# RUNPOD NETWORK VOLUME — S3-compatible model storage
# Used by scripts/storage/transfer_model_aws.py to upload model weights.
# NETWORK_VOLUME_ID is the bucket name; DATACENTER sets the region.
# =============================================================================
ACCESS_KEY=your_runpod_s3_access_key_here
SECRET_KEY=your_runpod_s3_secret_key_here
NETWORK_VOLUME_ID=your_network_volume_id_here
DATACENTER=us-mo-1
ENDPOINT_URL=https://s3api-us-mo-1.runpod.io
REMOTE_FOLDER=models/
